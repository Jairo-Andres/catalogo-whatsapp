# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings -> API). En Vercel van en Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (sb_publishable_...). Si tu panel solo muestra la "anon key",
# usa NEXT_PUBLIC_SUPABASE_ANON_KEY en su lugar. Ambas son públicas: las protege la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio (sin / final). En Vercel puedes omitirla: se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# No se necesita la service_role key: la app nunca la usa.
